# Copy to secrets.yaml (next to musik-display.yaml) and fill in.
# In the ESPHome add-on, these go into the shared esphome/secrets.yaml.
wifi_ssid: "MyWiFi"
wifi_password: "..."
api_encryption_key: "..."      # 32 bytes base64, e.g. from `openssl rand -base64 32`
ota_password: "..."
fallback_ap_password: "..."    # access point the display opens when WiFi fails
